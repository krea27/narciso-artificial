# Clave de API de Google AI Studio (https://aistudio.google.com/apikey)
# Copiá este archivo como .env y reemplazá el valor por tu clave real:
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui

# Modelo de generación de imagen (opcional)
# Por defecto se usa gemini-nano-banana-2.1 (Nano Banana 2.1, reemplazo activo de gemini-3.1-flash-image)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
